{
  "name": "tiling-editor",
  "version": "0.1.0",
  "private": true,
  "description": "2D tiling plan editor with a Three.js room preview",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-portable.mjs",
    "build:portable": "npm run typecheck && node scripts/build-portable.mjs",
    "test": "vitest run --project regression",
    "check": "npm run format:check && npm test && npm run build && npm run test:build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:build": "vitest run --project built",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:watch": "vitest --watch --project regression"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "mermaid": "11.17.2",
    "preact": "10.29.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
